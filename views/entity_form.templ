package views

import (
	"strconv"

	db "matematicos.com/servidor-go-tp1/db/sqlc"
)

// idStr convierte el id de una categoría al string que usan los <option>.
func idStr(id int32) string {
	return strconv.Itoa(int(id))
}

// FormError es el párrafo donde se muestra el error de validación de un
// formulario. Se renderiza siempre (vacío y oculto por CSS si no hay error)
// para que exista en el DOM como destino del header HX-Retarget.
templ FormError(id string, msg string, oob bool) {
	<p id={ id } class="error" role="alert" { oobAttrs(oob)... }>{ msg }</p>
}

// categoriaPadreField es el <select> opcional de categoría padre.
// Tiene id propio para poder actualizarlo con hx-swap-oob cuando se crea o
// se borra una categoría, así el listado de opciones nunca queda viejo.
templ categoriaPadreField(categorias []db.Categoria, oob bool) {
	<label id="categoria-padre-field" { oobAttrs(oob)... }>
		Categoría padre (opcional)
		<select name="id_padre">
			<option value="">Ninguna</option>
			for _, c := range categorias {
				<option value={ idStr(c.IDCat) }>{ c.NombreCat }</option>
			}
		</select>
	</label>
}

// productoCategoriaField es el <select> obligatorio de categoría del producto.
// Igual que el anterior, se actualiza con hx-swap-oob.
templ productoCategoriaField(categorias []db.Categoria, oob bool) {
	<label id="producto-categoria-field" { oobAttrs(oob)... }>
		Categoría
		<select name="id_cat" required>
			<option value="">Elegí una categoría</option>
			for _, c := range categorias {
				<option value={ idStr(c.IDCat) }>{ c.NombreCat }</option>
			}
		</select>
		if len(categorias) == 0 {
			<small>Primero tenés que crear al menos una categoría.</small>
		}
	</label>
}

// CategoriaForm es el formulario de alta de categorías.
// TP6: en vez de un POST clásico con recarga, HTMX envía el formulario por
// AJAX (hx-post) y reemplaza la tabla de categorías completa (hx-target +
// hx-swap="outerHTML") con el fragmento que devuelve el servidor.
// hx-on:htmx:after:swap limpia los campos después del swap (filmina 52), pero
// solo si el alta fue exitosa: en HTMX 4 las respuestas 4xx también se
// intercambian (el servidor manda el mensaje de error al párrafo del form), y
// en ese caso no queremos borrar lo que el usuario escribió.
templ CategoriaForm(categorias []db.Categoria) {
	<form
		id="categoria-form"
		hx-post="/categorias"
		hx-target="#categorias-table-container"
		hx-swap="outerHTML"
		hx-on:htmx:after:swap="if (event.detail.ctx.response.status < 400) this.reset()"
	>
		@FormError(CategoriaFormErrorID, "", false)
		<label>
			Nombre
			<input type="text" name="nombre_cat" maxlength="20" required/>
		</label>
		<label>
			Descripción
			<input type="text" name="descripcion_cat" maxlength="255" required/>
		</label>
		@categoriaPadreField(categorias, false)
		<button type="submit">Crear categoría</button>
	</form>
}

// ProductoForm es el formulario de alta de productos.
// Mismo patrón que CategoriaForm, apuntando a la tabla de productos.
templ ProductoForm(categorias []db.Categoria) {
	<form
		id="producto-form"
		hx-post="/productos"
		hx-target="#productos-table-container"
		hx-swap="outerHTML"
		hx-on:htmx:after:swap="if (event.detail.ctx.response.status < 400) this.reset()"
	>
		@FormError(ProductoFormErrorID, "", false)
		<label>
			Nombre
			<input type="text" name="nombre_prod" maxlength="30" required/>
		</label>
		<label>
			Descripción
			<input type="text" name="descripcion_prod" maxlength="255" required/>
		</label>
		<div class="grid">
			<label>
				Precio
				<input type="number" name="precio" min="0.01" step="0.01" required/>
			</label>
			<label>
				Stock
				<input type="number" name="stock" min="0" step="1" required/>
			</label>
		</div>
		@productoCategoriaField(categorias, false)
		<button type="submit">Crear producto</button>
	</form>
}
