package views

// Layout es la estructura HTML5 base que comparten todas las páginas.
// Recibe el título de la pestaña y renderiza adentro de <main> el contenido
// que se le pase como hijo ({ children... }).
// Pico.css se carga desde la CDN y le da estilo a los elementos HTML
// semánticos (tablas, formularios, botones) sin necesidad de clases propias.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.error { color: var(--pico-del-color); font-weight: bold; }
			</style>
		</head>
		<body>
			<header class="container">
				<h1>Mate Máticos</h1>
				<p>Catálogo de mates, termos, bombillas y accesorios materos.</p>
			</header>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}
