package views

// Layout es la estructura HTML5 base que comparten todas las páginas.
// Recibe el título de la pestaña y renderiza adentro de <main> el contenido
// que se le pase como hijo ({ children... }).
// Pico.css se carga desde la CDN y le da estilo a los elementos HTML
// semánticos (tablas, formularios, botones) sin necesidad de clases propias.
// TP6: HTMX 4.0.0 también se carga desde la CDN (filmina 38), con el hash de
// integridad para que el navegador rechace el archivo si fue modificado.
// El proyecto no tiene ningún archivo .js propio.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js" integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc" crossorigin="anonymous"></script>
			<style>
				.error { color: var(--pico-del-color); font-weight: bold; }
				.error:empty { display: none; }
				td button { margin: 0; padding: 0.25rem 0.75rem; font-size: 0.875rem; }
				td small.error { display: block; margin-top: 0.25rem; }
			</style>
		</head>
		<body>
			<header class="container">
				<h1>Mate Máticos</h1>
				<p>Catálogo de mates, termos, bombillas y accesorios materos.</p>
			</header>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}
