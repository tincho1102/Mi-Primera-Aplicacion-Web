package views

import db "matematicos.com/servidor-go-tp1/db/sqlc"

// Index es la página principal: integra el Layout con los dos formularios
// de alta y los listados de categorías y productos.
// Es la única página completa; después de la carga inicial (GET /) todas las
// altas y bajas se resuelven con HTMX intercambiando fragmentos.
templ Index(categorias []db.Categoria, productos []db.Producto) {
	@Layout("Mate Máticos") {
		<section class="grid">
			<article>
				<header><h2>Nueva categoría</h2></header>
				@CategoriaForm(categorias)
			</article>
			<article>
				<header><h2>Nuevo producto</h2></header>
				@ProductoForm(categorias)
			</article>
		</section>
		<section>
			<h2>Categorías</h2>
			@CategoriasTable(categorias)
		</section>
		<section>
			<h2>Productos</h2>
			@ProductosTable(productos, categorias)
		</section>
	}
}
