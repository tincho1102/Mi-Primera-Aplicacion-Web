package views

import db "matematicos.com/servidor-go-tp1/db/sqlc"

// Respuestas parciales de HTMX: cada handler de alta/borrado devuelve uno de
// estos componentes en lugar de la página completa.
// El primer elemento es el swap principal (va al hx-target del que hizo la
// petición); los que llevan oob=true son fragmentos "Out of Band" que HTMX
// ubica por id en otras partes de la página (filminas 48-49).

// CategoriaCreada es la respuesta de POST /categorias: la tabla actualizada,
// los dos <select> de categorías con la opción nueva y el párrafo de error
// del formulario vacío (por si había quedado un error anterior).
templ CategoriaCreada(categorias []db.Categoria) {
	@CategoriasTable(categorias)
	@categoriaPadreField(categorias, true)
	@productoCategoriaField(categorias, true)
	@FormError(CategoriaFormErrorID, "", true)
}

// CategoriaBorrada es la respuesta de DELETE /categorias/{id}. No tiene
// contenido principal (la fila se reemplaza por nada), solo fragmentos OOB:
// la tabla de productos, porque producto.id_cat tiene ON DELETE CASCADE, y
// los <select> para que no ofrezcan una categoría que ya no existe.
templ CategoriaBorrada(categorias []db.Categoria, productos []db.Producto) {
	@productosTable(productos, categorias, true)
	@categoriaPadreField(categorias, true)
	@productoCategoriaField(categorias, true)
}

// ProductoCreado es la respuesta de POST /productos: la tabla actualizada y
// el párrafo de error del formulario vacío.
templ ProductoCreado(productos []db.Producto, categorias []db.Categoria) {
	@ProductosTable(productos, categorias)
	@FormError(ProductoFormErrorID, "", true)
}
